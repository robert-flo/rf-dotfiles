#!/usr/bin/env bash
# ==============================================================================
# run_onchange_after_install-hunk.sh.tmpl
# Instala/actualiza hunk vía mise. Mismo prerrequisito y misma política de fallo
# que run_onchange_after_install-helix-tools.sh.tmpl: node primero (con
# locked_scopes [project, global] mise no lo resuelve solo en un usuario nuevo) y,
# con RF_APPLY_FULL=1 (make apply*), un fallo real termina con exit != 0.
# ==============================================================================
set -euo pipefail

echo "==> [chezmoi] Instalando/actualizando hunk vía mise para {{ .chezmoi.username }}..."

if ! command -v mise >/dev/null 2>&1; then
  echo "==> [chezmoi] Omitiendo instalación de hunk (mise no disponible)."
  exit 0
fi

# $1 = qué falló, $2 = código de salida de mise
fail_or_warn() {
  if [[ "${RF_APPLY_FULL:-0}" == 1 ]]; then
    echo "==> [chezmoi] ERROR: apply completo (make apply*): $1 (código $2)." >&2
    exit 1
  fi
  echo "==> [chezmoi] Aviso: $1 (código $2); omitiendo para no bloquear chezmoi."
  exit 0
}

# Prerrequisito: node. `mise where` no toca la red; solo se instala si falta.
if ! mise where node@latest >/dev/null 2>&1; then
  echo "==> [chezmoi] Instalando node (prerrequisito de hunk)..."
  status=0
  mise install --quiet node@latest || status=$?
  if [[ $status -ne 0 ]]; then
    fail_or_warn "falló la instalación de node vía mise, prerrequisito de hunk" "$status"
  fi
fi

status=0
mise use -g --quiet hunk@latest || status=$?
if [[ $status -ne 0 ]]; then
  fail_or_warn "falló la instalación de hunk vía mise" "$status"
fi
