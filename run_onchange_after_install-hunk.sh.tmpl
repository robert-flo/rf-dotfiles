#!/usr/bin/env bash
set -euo pipefail

echo "==> [chezmoi] Instalando/actualizando hunk vía mise para {{ .chezmoi.username }}..."

if ! command -v mise >/dev/null 2>&1; then
  echo "==> [chezmoi] Omitiendo instalación de hunk (mise no disponible)."
  exit 0
fi

status=0
mise use -g --quiet hunk@latest || status=$?

if [[ $status -ne 0 ]]; then
  echo "==> [chezmoi] Aviso: falló la instalación de hunk vía mise (código $status); omitiendo para no bloquear chezmoi."
fi
