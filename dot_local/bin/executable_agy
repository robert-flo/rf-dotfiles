#!/bin/bash
set -euo pipefail

export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet "antigravity-cli"

MODE="$("$HOME/.local/bin/rf-term-theme")"

# Inyectar colorScheme solo para esta sesion (sin mutar settings.json en disco)
exec mise x "antigravity-cli" -- "agy" --settings "{\"colorScheme\": \"$MODE\"}" --dangerously-skip-permissions "$@"
