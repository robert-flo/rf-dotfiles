#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet "antigravity-cli" || exit 1

# Detectar modo (light/dark) desde Clavis o fallback a light
MODE="light"
CLAVIS_CFG="$HOME/.config/clavis/config.json"
if [ -f "$CLAVIS_CFG" ] && command -v jq >/dev/null 2>&1; then
    DETECTED_MODE=$(jq -r '.theme.mode // empty' "$CLAVIS_CFG" 2>/dev/null)
    if [ "$DETECTED_MODE" = "dark" ] || [ "$DETECTED_MODE" = "light" ]; then
        MODE="$DETECTED_MODE"
    fi
fi

# Sincronizar colorScheme en settings.json para persistencia
SETTINGS_FILE="$HOME/.gemini/antigravity-cli/settings.json"
if [ -f "$SETTINGS_FILE" ] && command -v jq >/dev/null 2>&1; then
    CURRENT_SCHEME=$(jq -r '.colorScheme // empty' "$SETTINGS_FILE" 2>/dev/null)
    if [ "$CURRENT_SCHEME" != "$MODE" ]; then
        jq --arg mode "$MODE" '. + {"colorScheme": $mode}' "$SETTINGS_FILE" > "$SETTINGS_FILE.tmp" && mv "$SETTINGS_FILE.tmp" "$SETTINGS_FILE"
    fi
fi

# Inyectar colorScheme en la sesion para garantizar contraste en fondo claro/oscuro
exec mise x "antigravity-cli" -- "agy" --settings "{\"colorScheme\": \"$MODE\"}" --dangerously-skip-permissions "$@"
