#!/usr/bin/env python3
"""chrome-h264 — Chrome (o Beta, Chromium, Edge) con H.264 forzado en YouTube (opt-in).

La HD 530 decodifica H.264 por hardware (VA-API) pero no VP9 ni AV1. YouTube
prefiere AV1/VP9, y Chrome los decodifica por software (≈100-130 % de un núcleo
a 1080p60). Este lanzador abre el navegador en un perfil propio y, antes de que
cargue cada página, inyecta ~/.local/share/chrome-h264/h264only.js, que oculta
VP9/AV1 y deja a YouTube con H.264 (≈40-50 %).

Por qué así: Chrome de marca (158) ignora --load-extension, y la depuración remota
está bloqueada sobre el perfil por defecto. Se usa --remote-debugging-pipe (sin
puerto TCP) con un user-data-dir dedicado.

Activar:    chrome-h264 [-b stable|beta|chromium|edge] [URL...]   (por defecto: stable)
Desactivar: abrir el navegador como siempre; su perfil normal no se toca.
Limpiar:    chrome-h264 --clean [-b NAVEGADOR]   (borra los perfiles dedicados; sin -b, todos)

Solo la biblioteca estándar de Python. Los flags salen del wrapper de cada navegador
(~/.config/chrome-flags.conf, chromium-flags.conf…), igual que al abrirlo normalmente.
"""
import argparse
import fcntl
import json
import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
ROOT = Path(os.environ.get("CHROME_H264_PROFILE", STATE / "chrome-h264"))
SCRIPT = Path(os.environ.get("CHROME_H264_SCRIPT", HOME / ".local/share/chrome-h264/h264only.js"))
# nombre corto -> comando que lee el archivo de flags de ese navegador
BROWSERS = {
    "stable": "google-chrome-stable",
    "beta": "google-chrome-beta",
    "chromium": "chromium",
    "edge": "microsoft-edge-stable",
}
# Brave Origin 158 no sirve: su binario termina con "Remote debugging pipe file descriptors are not open"
# aunque el lanzador le pase los fd 3 y 4, así que no hay forma de inyectar el script.
INJECTABLE = {"page", "iframe"}


def log(msg):
    print(f"chrome-h264: {msg}", file=sys.stderr)


def running_instance(profile):
    """PID del navegador que ya usa el perfil, o None (SingletonLock apunta a host-pid)."""
    lock = profile / "SingletonLock"
    try:
        pid = int(os.readlink(lock).rsplit("-", 1)[1])
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError, IndexError):
        return None


class Pipe:
    """Protocolo --remote-debugging-pipe: JSON separado por NUL, fd 3 (entra) y 4 (sale)."""

    def __init__(self, rfd, wfd):
        self.rfd, self.wfd, self.buf, self.next_id = rfd, wfd, b"", 0

    def send(self, method, params=None, session=None):
        self.next_id += 1
        msg = {"id": self.next_id, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        os.write(self.wfd, json.dumps(msg).encode() + b"\0")

    def messages(self):
        while True:
            chunk = os.read(self.rfd, 65536)
            if not chunk:
                return
            self.buf += chunk
            while b"\0" in self.buf:
                raw, self.buf = self.buf.split(b"\0", 1)
                yield json.loads(raw)


AUTO_ATTACH = {"autoAttach": True, "waitForDebuggerOnStart": True, "flatten": True}


def serve(pipe, source, verbose):
    """Cada target nuevo arranca pausado: se inyecta el script y recién ahí se reanuda."""
    pipe.send("Target.setAutoAttach", AUTO_ATTACH)
    for msg in pipe.messages():
        if msg.get("method") != "Target.attachedToTarget":
            continue
        p = msg["params"]
        session, kind = p["sessionId"], p["targetInfo"]["type"]
        if kind in INJECTABLE:
            pipe.send("Page.enable", session=session)
            pipe.send("Page.addScriptToEvaluateOnNewDocument", {"source": source}, session)
            pipe.send("Target.setAutoAttach", AUTO_ATTACH, session)
            if verbose:
                log(f"inyectado en {kind} {p['targetInfo'].get('url', '')[:80]}")
        if p.get("waitingForDebugger"):
            pipe.send("Runtime.runIfWaitingForDebugger", session=session)


def fd_above(fd, floor=10):
    new = fcntl.fcntl(fd, fcntl.F_DUPFD_CLOEXEC, floor)
    os.close(fd)
    return new


def launch(args, extra):
    if not SCRIPT.is_file():
        log(f"falta {SCRIPT}; corré `chezmoi apply`")
        return 1
    profile = ROOT / args.browser
    pid = running_instance(profile)
    if pid:
        log(f"ya hay un chrome-h264 ({args.browser}) abierto (pid {pid}); cerralo o usá esa ventana")
        return 1
    profile.mkdir(parents=True, exist_ok=True)
    source = SCRIPT.read_text(encoding="utf-8")

    to_chrome_r, to_chrome_w = (fd_above(f) for f in os.pipe())
    from_chrome_r, from_chrome_w = (fd_above(f) for f in os.pipe())

    def into_fds():
        os.dup2(to_chrome_r, 3)
        os.dup2(from_chrome_w, 4)

    cmd = [
        os.environ.get("CHROME_H264_BIN", BROWSERS[args.browser]),
        f"--user-data-dir={profile}",
        "--remote-debugging-pipe",
        "--no-first-run",
        *(["--autoplay-policy=no-user-gesture-required"] if args.autoplay else []),
        *extra,
    ]
    proc = None

    def forward(sig, _frame):
        if proc:
            proc.send_signal(sig)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)
    proc = subprocess.Popen(cmd, preexec_fn=into_fds, close_fds=False)
    os.close(to_chrome_r)
    os.close(from_chrome_w)
    try:
        serve(Pipe(from_chrome_r, to_chrome_w), source, args.verbose)
    except (OSError, ValueError, KeyError) as exc:
        log(f"AVISO: se perdió el canal con Chrome ({exc}); las páginas nuevas ya no llevan la inyección")
    code = proc.wait()
    return 128 - code if code < 0 else code


def clean(browser):
    # Sin -b se borra toda la carpeta raíz (también restos de versiones anteriores del lanzador).
    target = ROOT / browser if browser else ROOT
    if any(running_instance(ROOT / name) for name in BROWSERS):
        log("hay un chrome-h264 abierto; cerralo antes de limpiar")
        return 1
    if target.exists():
        shutil.rmtree(target)
        log(f"borrado {target}")
    else:
        log("no había nada que limpiar")
    return 0


def main():
    ap = argparse.ArgumentParser(description="Navegador Chromium con H.264 forzado en YouTube (opt-in). Argumentos extra (URLs, flags) se pasan al navegador.")
    ap.add_argument("-b", "--browser", choices=sorted(BROWSERS), default=None, help="navegador (al lanzar: stable por defecto; con --clean: sin -b se borran todos)")
    ap.add_argument("--clean", action="store_true", help="borra los perfiles dedicados (los de -b, o todos) y sale")
    ap.add_argument("--autoplay", action="store_true", help="permite reproducción automática (pruebas)")
    ap.add_argument("-v", "--verbose", action="store_true", help="muestra dónde se inyecta el script")
    args, extra = ap.parse_known_args()
    if args.clean:
        return clean(args.browser)
    args.browser = args.browser or "stable"
    return launch(args, extra)


if __name__ == "__main__":
    sys.exit(main())
