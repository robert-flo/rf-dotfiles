#!/usr/bin/env bash
# ==============================================================================
# yt-video — Descargador de video (<=1080p MP4) vía yt-dlp a nivel de sistema.
#
# Pre-chequea y descarga subtítulos (mitigando HTTP 429) antes de bajar video,
# y presenta un menú manual obligatorio de calidades <=1080p (Premium → 1080p → 720p).
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/yt-common.sh" ]]; then
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/yt-common.sh"
elif [[ -f "/usr/local/lib/yt-tools/yt-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "/usr/local/lib/yt-tools/yt-common.sh"
else
  echo "[yt-video] Error: no se encontró yt-common.sh" >&2
  exit 1
fi

yt_init_colors

if [[ $# -eq 0 ]]; then
  cat << EOF
${C_BOLD}${C_BLUE}yt-video${C_RST} — Descarga video individual en <=1080p MP4 (+ pre-chequeo de subtítulos)

${C_BOLD}Uso:${C_RST}
  ${C_GREEN}yt-video${C_RST} ${C_CYAN}[OPCIONES_YT_DLP]${C_RST} <URL> [URL...]

${C_BOLD}Características predeterminadas:${C_RST}
  - ${C_CYAN}Subtítulos:${C_RST} pre-chequeo anti-429 antes de bajar el video (EN por defecto; confirma si falla)
  - ${C_CYAN}Menú <=1080p:${C_RST} 1080p Premium (HLS) → variantes 1080p (vp9/av01/h264) → mejor 720p (sin default)
  - ${C_CYAN}Incrustado:${C_RST} metadatos, capítulos, miniatura y subtítulos (.srt) en el MP4
  - ${C_CYAN}Reanudación:${C_RST} --continue --no-overwrites y protección anti-429 (--sleep-requests 1)
  - ${C_CYAN}Destino:${C_RST} /zt/yt-downloads/video/ ${C_DIM}(fallback: ~/yt-downloads/video/)${C_RST}
  - ${C_CYAN}Bypass menú:${C_RST} pasar -f explícito o ejecutar sin terminal interactiva (mantiene tope <=1080p)

${C_BOLD}Ejemplos:${C_RST}
  ${C_GREEN}yt-video${C_RST} "https://youtu.be/Shqtk_2Jd3c"                 ${C_DIM}# Pre-chequea subs + menú <=1080p${C_RST}
  ${C_GREEN}yt-video${C_RST} --sub-langs "es,en" "https://youtu.be/..."     ${C_DIM}# Pre-chequea subs en español e inglés${C_RST}
  ${C_GREEN}yt-video${C_RST} -f "bv*[height<=1080]+ba" "https://youtu.be/..." ${C_DIM}# Saltar menú con formato explícito${C_RST}
  ${C_GREEN}yt-video${C_RST} -P ~/Videos "https://youtu.be/..."             ${C_DIM}# Guardar en carpeta Videos${C_RST}
EOF
  exit 0
fi

yt_check_deps "yt-video" ffmpeg aria2c deno

BASE_DIR="$(yt_base_dir)"
DEST_DIR="$BASE_DIR/video"
USER_SET_FORMAT=false
USER_SET_DEST=false
SKIP_SUBS=false
PASSTHROUGH_ONLY=false
SUB_LANGS="en"
YT_SUBS_STATUS="skipped"

PASS_ARGS=()
EXTRA_PROBE_ARGS=()
URLS=()

end_of_opts=false
while [[ $# -gt 0 ]]; do
  arg="$1"
  shift

  if [[ "$end_of_opts" == true ]]; then
    URLS+=("$arg")
    continue
  fi

  case "$arg" in
    --)
      end_of_opts=true
      ;;
    -h|--help|--version|-F|--list-formats|-J|--dump-json|--dump-single-json|--list-subs|-s|--simulate)
      PASSTHROUGH_ONLY=true
      PASS_ARGS+=("$arg")
      ;;
    --no-subs|--no-write-subs)
      SKIP_SUBS=true
      if [[ "$arg" == "--no-write-subs" ]]; then
        PASS_ARGS+=("$arg")
      fi
      ;;
    -f|--format)
      USER_SET_FORMAT=true
      PASS_ARGS+=("$arg")
      if [[ $# -gt 0 ]]; then
        PASS_ARGS+=("$1")
        shift
      fi
      ;;
    -f=*|--format=*)
      USER_SET_FORMAT=true
      PASS_ARGS+=("$arg")
      ;;
    --sub-langs)
      PASS_ARGS+=("$arg")
      if [[ $# -gt 0 ]]; then
        SUB_LANGS="$1"
        PASS_ARGS+=("$1")
        shift
      fi
      ;;
    --sub-langs=*)
      SUB_LANGS="${arg#--sub-langs=}"
      PASS_ARGS+=("$arg")
      ;;
    -P|--paths)
      USER_SET_DEST=true
      PASS_ARGS+=("$arg")
      if [[ $# -gt 0 ]]; then
        DEST_DIR="$1"
        PASS_ARGS+=("$1")
        shift
      fi
      ;;
    -P=*|--paths=*)
      USER_SET_DEST=true
      DEST_DIR="${arg#*=}"
      PASS_ARGS+=("$arg")
      ;;
    --cookies|--cookies-from-browser|--extractor-args)
      PASS_ARGS+=("$arg")
      EXTRA_PROBE_ARGS+=("$arg")
      if [[ $# -gt 0 ]]; then
        PASS_ARGS+=("$1")
        EXTRA_PROBE_ARGS+=("$1")
        shift
      fi
      ;;
    --cookies=*|--cookies-from-browser=*|--extractor-args=*)
      PASS_ARGS+=("$arg")
      EXTRA_PROBE_ARGS+=("$arg")
      ;;
    -o|--output|--downloader|--downloader-args|--merge-output-format|-S|--format-sort|--proxy)
      PASS_ARGS+=("$arg")
      if [[ $# -gt 0 ]]; then
        PASS_ARGS+=("$1")
        shift
      fi
      ;;
    -*)
      PASS_ARGS+=("$arg")
      ;;
    *)
      URLS+=("$arg")
      ;;
  esac
done

mkdir -p "$DEST_DIR" 2>/dev/null || true

if [[ "$PASSTHROUGH_ONLY" == true || ${#URLS[@]} -eq 0 ]]; then
  exec yt-dlp --ignore-config --no-playlist "${PASS_ARGS[@]}" "${URLS[@]}"
fi

for url in "${URLS[@]}"; do
  YT_SUBS_STATUS="skipped"
  if [[ "$SKIP_SUBS" == false ]]; then
    if ! yt_prepare_subtitles "yt-video" "$url" "$DEST_DIR" "$SUB_LANGS" EXTRA_PROBE_ARGS; then
      exit 1
    fi
  fi

  SELECTED_FORMAT=""
  if [[ "$USER_SET_FORMAT" == false ]]; then
    if yt_is_interactive; then
      if ! yt_select_format "yt-video" "$url" SELECTED_FORMAT EXTRA_PROBE_ARGS; then
        exit 1
      fi
    else
      SELECTED_FORMAT="bv*[height<=1080]+ba/b[height<=1080]"
    fi
  fi

  FINAL_ARGS=(
    --ignore-config
    --no-playlist
    --continue
    --no-overwrites
    --sleep-requests 1
    --merge-output-format mp4
    --embed-metadata
    --embed-chapters
    --embed-thumbnail
    --convert-thumbnails jpg
  )

  if [[ "$USER_SET_FORMAT" == false ]]; then
    FINAL_ARGS+=(-f "$SELECTED_FORMAT" -S "res:1080")
  fi

  if [[ "$SKIP_SUBS" == false && "$YT_SUBS_STATUS" == "ok" ]]; then
    FINAL_ARGS+=(--embed-subs --convert-subs srt)
  fi

  if [[ "$USER_SET_DEST" == false ]]; then
    FINAL_ARGS+=(-P "$DEST_DIR")
  fi

  if command -v aria2c >/dev/null 2>&1; then
    FINAL_ARGS+=(
      --downloader aria2c
      --downloader-args aria2c:'--continue --min-split-size=5M --max-connection-per-server=8'
    )
  fi

  yt-dlp "${FINAL_ARGS[@]}" "${PASS_ARGS[@]}" "$url"
done
