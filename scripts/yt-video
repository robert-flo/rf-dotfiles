#!/usr/bin/env bash
# ==============================================================================
# yt-video — Descargador de video (1080p MP4) vía yt-dlp a nivel de sistema.
#
# Descarga video individual en alta definición (hasta 1080p) con audio integrado
# en formato MP4, subtítulos en inglés opcionales (soft subs) y miniatura incrustada.
# ==============================================================================
set -euo pipefail

# Colores ANSI estándar (0-15) compatibles con modo claro y modo oscuro
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_BOLD=$'\033[1m'
  C_BLUE=$'\033[34m'
  C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
  C_RST=$'\033[0m'
else
  C_BOLD=""; C_BLUE=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_DIM=""; C_RST=""
fi

if [[ $# -eq 0 ]]; then
  cat << EOF
${C_BOLD}${C_BLUE}yt-video${C_RST} — Descarga video individual en 1080p MP4 (+ subtítulos EN opcionales)

${C_BOLD}Uso:${C_RST}
  ${C_GREEN}yt-video${C_RST} ${C_CYAN}[OPCIONES_YT_DLP]${C_RST} <URL> [URL...]

${C_BOLD}Características predeterminadas:${C_RST}
  - ${C_CYAN}Formato:${C_RST} hasta 1080p real (horizontal o vertical) + mejor audio en MP4 (-S "res:1080")
  - ${C_CYAN}Incrustado:${C_RST} metadatos, capítulos y miniatura en el MP4
  - ${C_CYAN}Subtítulos:${C_RST} inglés (manuales o autogenerados) como pista opcional (en mpv: tecla 'v')
  - ${C_CYAN}Reanudación:${C_RST} --continue --no-overwrites y protección ligera anti-429 (--sleep-requests 1)
  - ${C_CYAN}Playlist:${C_RST} omitida por defecto (--no-playlist). Para listas usa '${C_BLUE}yt-video-playlist${C_RST}'; para X usa '${C_BLUE}yt-x${C_RST}'
  - ${C_CYAN}Destino:${C_RST} /zt/yt-downloads/video/ ${C_DIM}(fallback: ~/yt-downloads/video/)${C_RST}
  - ${C_CYAN}Acelerador:${C_RST} aria2c multiproceso (si está disponible en el sistema)
  - ${C_CYAN}Transparencia:${C_RST} cualquier flag adicional de yt-dlp sobreescribe los valores por defecto.

${C_BOLD}Ejemplos:${C_RST}
  ${C_GREEN}yt-video${C_RST} "https://youtu.be/Shqtk_2Jd3c"                 ${C_DIM}# Descargar video 1080p MP4 + subs EN${C_RST}
  ${C_GREEN}yt-video${C_RST} --sub-langs "es,en" "https://youtu.be/..."     ${C_DIM}# Incluir también subtítulos en español${C_RST}
  ${C_GREEN}yt-video${C_RST} -f "bestvideo+bestaudio" "https://youtu.be/..." ${C_DIM}# Máxima calidad disponible (4K/etc.)${C_RST}
  ${C_GREEN}yt-video${C_RST} -P ~/Videos "https://youtu.be/..."             ${C_DIM}# Guardar en carpeta Videos${C_RST}
EOF
  exit 0
fi

# Verificación ligera de dependencias óptimas (solo avisa si falta alguna)
_missing=()
for _bin in ffmpeg aria2c deno; do
  command -v "$_bin" >/dev/null 2>&1 || _missing+=("$_bin")
done
python3 -c "import curl_cffi" 2>/dev/null || _missing+=("python-curl_cffi")
if [[ ${#_missing[@]} -gt 0 ]]; then
  printf '%s[yt-video] Aviso: faltan dependencias óptimas (%s). Ejecuta '\''chezmoi apply'\''.%s\n' \
    "$C_YELLOW" "${_missing[*]}" "$C_RST" >&2
fi

# Directorio base unificado (/zt/yt-downloads si /zt existe, si no ~/yt-downloads)
if [[ -d "/zt" ]]; then
  BASE_DIR="/zt/yt-downloads"
else
  BASE_DIR="$HOME/yt-downloads"
fi
DEST_DIR="$BASE_DIR/video"
mkdir -p "$DEST_DIR" 2>/dev/null || true

DEFAULT_ARGS=(
  --ignore-config
  --no-playlist
  --ignore-errors
  --continue
  --no-overwrites
  --sleep-requests 1
  -f "bv*+ba/b"
  -S "res:1080"
  --merge-output-format mp4
  --embed-metadata
  --embed-chapters
  --embed-thumbnail
  --convert-thumbnails jpg
  --write-subs
  --write-auto-subs
  --sub-langs "en,-live_chat"
  --sleep-subtitles 2
  --convert-subs srt
  --embed-subs
  -P "$DEST_DIR"
)

# Aceleración paralela con aria2c para evitar el límite de velocidad por conexión
if command -v aria2c >/dev/null 2>&1; then
  DEFAULT_ARGS+=(
    --downloader aria2c
    --downloader-args aria2c:'--continue --min-split-size=5M --max-connection-per-server=8'
  )
fi

exec yt-dlp "${DEFAULT_ARGS[@]}" "$@"
