#!/usr/bin/env bash
# ==============================================================================
# yt-video — Descargador de video (1080p MP4) vía yt-dlp a nivel de sistema.
#
# Ignora la configuración local de audio/música (~/.config/yt-dlp/config) y descarga
# video en alta definición (hasta 1080p) con audio integrado en formato MP4.
# ==============================================================================
set -euo pipefail

if [[ $# -eq 0 ]]; then
  cat << 'EOF'
Uso: yt-video [OPCIONES_YT_DLP] <URL> [URL...]

Descarga videos de YouTube (y otras plataformas soportadas) en resolución máxima 1080p
con audio integrado en formato MP4, omitiendo la configuración musical local de yt-dlp.

Características predeterminadas:
  - Formato: hasta 1080p (video + mejor audio combinados)
  - Contenedor: MP4 con metadatos, capítulos y miniatura incrustados
  - Subtítulos: inglés (manuales o autogenerados) como pista opcional activable/ocultable (en mpv: tecla 'v')
  - Reanudación: --continue --no-overwrites y protección ligera anti-429 (--sleep-requests 1)
  - Playlist: omitida por defecto (--no-playlist). Para listas completas usa 'yt-playlist'
  - Destino: ~/Downloads/ (o directorio indicado con -P)
  - Acelerador: aria2c multiproceso (si está disponible en el sistema)
  - Transparencia: cualquier flag adicional de yt-dlp sobreescribe los valores por defecto.

Ejemplos:
  yt-video https://youtu.be/Shqtk_2Jd3c
  yt-video --sub-langs "es,en" https://youtu.be/...      # Incluir también español
  yt-video -f "bestvideo+bestaudio" https://youtu.be/...  # Máxima calidad disponible
  yt-video -P ~/Videos https://youtu.be/...              # Guardar en carpeta Videos
EOF
  exit 0
fi

# Verificación ligera de dependencias óptimas (solo avisa si falta alguna)
_missing=()
for _bin in ffmpeg aria2c deno; do
  command -v "$_bin" >/dev/null 2>&1 || _missing+=("$_bin")
done
python3 -c "import curl_cffi" 2>/dev/null || _missing+=("python-curl_cffi")
if [[ ${#_missing[@]} -gt 0 ]]; then
  printf '\033[33m[yt-video] Aviso: faltan dependencias óptimas (%s). Ejecuta '\''chezmoi apply'\''.\033[0m\n' "${_missing[*]}" >&2
fi

# Directorio de descarga predeterminado
DEST_DIR="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}"
mkdir -p "$DEST_DIR" 2>/dev/null || true

DEFAULT_ARGS=(
  --ignore-config
  --no-playlist
  --ignore-errors
  --continue
  --no-overwrites
  --sleep-requests 1
  -f "bv*[height<=1080]+ba/b[height<=1080]"
  --merge-output-format mp4
  --embed-metadata
  --embed-chapters
  --embed-thumbnail
  --convert-thumbnails jpg
  --write-subs
  --write-auto-subs
  --sub-langs "en,-live_chat"
  --sleep-subtitles 2
  --convert-subs srt
  --embed-subs
  -P "$DEST_DIR"
)

# Aceleración paralela con aria2c para evitar el límite de velocidad por conexión
if command -v aria2c >/dev/null 2>&1; then
  DEFAULT_ARGS+=(
    --downloader aria2c
    --downloader-args aria2c:'--continue --min-split-size=5M --max-connection-per-server=8'
  )
fi

exec yt-dlp "${DEFAULT_ARGS[@]}" "$@"
