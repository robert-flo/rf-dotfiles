#!/usr/bin/env bash
# ==============================================================================
# yt-video-playlist — Descargador de playlists de estudio/video (1080p MP4).
#
# Descarga playlists completas en subcarpetas ordenadas (001 - Título [id].mp4),
# con subtítulos opcionales en inglés, miniatura incrustada, pausas anti-429
# e historial de progreso por playlist en ~/.local/state/yt-video-playlist/.
# ==============================================================================
set -euo pipefail

# Colores ANSI estándar (0-15) compatibles con modo claro y modo oscuro
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_BOLD=$'\033[1m'
  C_BLUE=$'\033[34m'
  C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
  C_RST=$'\033[0m'
else
  C_BOLD=""; C_BLUE=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_DIM=""; C_RST=""
fi

if [[ $# -eq 0 ]]; then
  cat << EOF
${C_BOLD}${C_BLUE}yt-video-playlist${C_RST} — Descarga playlists de video/cursos en 1080p MP4 (+ subs EN opcionales)

${C_BOLD}Uso:${C_RST}
  ${C_GREEN}yt-video-playlist${C_RST} ${C_CYAN}[--list | -L] [--no-archive] [OPCIONES_YT_DLP]${C_RST} <URL_PLAYLIST> [URL...]

${C_BOLD}Opciones propias del wrapper:${C_RST}
  ${C_CYAN}--list, -L${C_RST}     Inspección rápida: lista índice, duración y título de cada video sin descargar
  ${C_CYAN}--no-archive${C_RST}   Omite el archivo de progreso (permite re-descargar videos ya registrados)

${C_BOLD}Características predeterminadas:${C_RST}
  - ${C_CYAN}Playlist:${C_RST} descarga completa (--yes-playlist) saltando videos no disponibles (--ignore-errors)
  - ${C_CYAN}Organización:${C_RST} ~/Videos/Playlists/<Nombre de la Playlist>/001 - Título [id].mp4
  - ${C_CYAN}Progreso:${C_RST} ~/.local/state/yt-video-playlist/<playlist_id>.archive (salta clases ya bajadas)
  - ${C_CYAN}Formato:${C_RST} hasta 1080p (video + mejor audio combinados) en MP4
  - ${C_CYAN}Incrustado:${C_RST} miniatura, metadatos y capítulos en cada MP4
  - ${C_CYAN}Subtítulos:${C_RST} inglés (manuales o autogenerados) como pista opcional (en mpv: tecla 'v')
  - ${C_CYAN}Protección anti-429:${C_RST} pausas cortas entre peticiones, videos y subtítulos
  - ${C_CYAN}Acelerador:${C_RST} aria2c multiproceso (si está disponible en el sistema)
  - ${C_CYAN}Transparencia:${C_RST} cualquier flag adicional de yt-dlp sobreescribe los valores por defecto.

${C_BOLD}Ejemplos:${C_RST}
  ${C_GREEN}yt-video-playlist${C_RST} --list "https://www.youtube.com/playlist?list=..."              ${C_DIM}# Ver clases antes de descargar${C_RST}
  ${C_GREEN}yt-video-playlist${C_RST} "https://www.youtube.com/playlist?list=..."                     ${C_DIM}# Descargar playlist completa en ~/Videos/Playlists/${C_RST}
  ${C_GREEN}yt-video-playlist${C_RST} --playlist-items 1-10 "https://www.youtube.com/playlist?list=..." ${C_DIM}# Descargar solo clases 1 a 10${C_RST}
  ${C_GREEN}yt-video-playlist${C_RST} -P ~/Downloads "https://www.youtube.com/playlist?list=..."        ${C_DIM}# Guardar en otra carpeta${C_RST}
EOF
  exit 0
fi

# Parsear flags propios del wrapper sin interferir con los flags de yt-dlp
LIST_ONLY=false
USE_ARCHIVE=true
USER_SET_ARCHIVE=false
PASS_ARGS=()
PLAYLIST_ID=""

for arg in "$@"; do
  case "$arg" in
    --list|-L)
      LIST_ONLY=true
      ;;
    --no-archive)
      USE_ARCHIVE=false
      ;;
    --download-archive|--download-archive=*)
      USER_SET_ARCHIVE=true
      PASS_ARGS+=("$arg")
      ;;
    *)
      PASS_ARGS+=("$arg")
      if [[ -z "$PLAYLIST_ID" && "$arg" =~ [?\&]list=([A-Za-z0-9_-]+) ]]; then
        PLAYLIST_ID="${BASH_REMATCH[1]}"
      fi
      ;;
  esac
done

# Modo inspección rápida: muestra índice, duración y título sin descargar
if [[ "$LIST_ONLY" == true ]]; then
  exec yt-dlp \
    --ignore-config \
    --flat-playlist \
    --yes-playlist \
    --print "%(playlist_index)03d | %(duration_string)8s | %(title)s [%(id)s]" \
    "${PASS_ARGS[@]}"
fi

# Verificación ligera de dependencias óptimas (solo avisa si falta alguna)
_missing=()
for _bin in ffmpeg aria2c deno; do
  command -v "$_bin" >/dev/null 2>&1 || _missing+=("$_bin")
done
python3 -c "import curl_cffi" 2>/dev/null || _missing+=("python-curl_cffi")
if [[ ${#_missing[@]} -gt 0 ]]; then
  printf '%s[yt-video-playlist] Aviso: faltan dependencias óptimas (%s). Ejecuta '\''chezmoi apply'\''.%s\n' \
    "$C_YELLOW" "${_missing[*]}" "$C_RST" >&2
fi

# Directorio base de descarga predeterminado para playlists/cursos
DEST_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}/Playlists"
mkdir -p "$DEST_DIR" 2>/dev/null || true

DEFAULT_ARGS=(
  --ignore-config
  --yes-playlist
  --ignore-errors
  --continue
  --no-overwrites
  --sleep-requests 1
  --sleep-interval 2
  --max-sleep-interval 5
  -f "bv*[height<=1080]+ba/b[height<=1080]"
  --merge-output-format mp4
  --embed-metadata
  --embed-chapters
  --embed-thumbnail
  --convert-thumbnails jpg
  --write-subs
  --write-auto-subs
  --sub-langs "en,-live_chat"
  --sleep-subtitles 2
  --convert-subs srt
  --embed-subs
  -P "$DEST_DIR"
  -o "%(playlist_title,playlist_id)s/%(playlist_index)03d - %(title)s [%(id)s].%(ext)s"
)

# Archivo de progreso por playlist fuera de la carpeta de videos
if [[ "$USE_ARCHIVE" == true && "$USER_SET_ARCHIVE" == false ]]; then
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yt-video-playlist"
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  ARCHIVE_NAME="${PLAYLIST_ID:-default}.archive"
  DEFAULT_ARGS+=(--download-archive "$STATE_DIR/$ARCHIVE_NAME")
fi

# Aceleración paralela con aria2c para evitar el límite de velocidad por conexión
if command -v aria2c >/dev/null 2>&1; then
  DEFAULT_ARGS+=(
    --downloader aria2c
    --downloader-args aria2c:'--continue --min-split-size=5M --max-connection-per-server=8'
  )
fi

exec yt-dlp "${DEFAULT_ARGS[@]}" "${PASS_ARGS[@]}"
