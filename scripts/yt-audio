#!/usr/bin/env bash
# ==============================================================================
# yt-audio — Descargador de audio musical (Opus máxima calidad) vía yt-dlp.
#
# Extrae audio individual en formato Opus con carátula 1:1 incrustada, metadatos
# limpios, recorte SponsorBlock y post-procesado automático (yt-dlp-music-postprocess).
# ==============================================================================
set -euo pipefail

# Colores ANSI estándar (0-15) compatibles con modo claro y modo oscuro
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_BOLD=$'\033[1m'
  C_BLUE=$'\033[34m'
  C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
  C_RST=$'\033[0m'
else
  C_BOLD=""; C_BLUE=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_DIM=""; C_RST=""
fi

if [[ $# -eq 0 ]]; then
  cat << EOF
${C_BOLD}${C_BLUE}yt-audio${C_RST} — Descarga audio individual en Opus (máxima calidad + carátula 1:1)

${C_BOLD}Uso:${C_RST}
  ${C_GREEN}yt-audio${C_RST} ${C_CYAN}[OPCIONES_YT_DLP]${C_RST} <URL> [URL...]

${C_BOLD}Características predeterminadas:${C_RST}
  - ${C_CYAN}Formato:${C_RST} Opus máxima calidad (-x --audio-format opus --audio-quality 0)
  - ${C_CYAN}Carátula y tags:${C_RST} iTunes 1:1 o miniatura recortada (METADATA_BLOCK_PICTURE) + tags limpios
  - ${C_CYAN}SponsorBlock:${C_RST} elimina segmentos sponsor, selfpromo e interaction
  - ${C_CYAN}Playlist:${C_RST} omitida por defecto (--no-playlist). Para listas usa '${C_BLUE}yt-audio-playlist${C_RST}'
  - ${C_CYAN}Destino:${C_RST} /z-drive/idalia/MUSICA/Downloads/<uploader>/ ${C_DIM}(fallback: ~/Music/Downloads/)${C_RST}
  - ${C_CYAN}Acelerador:${C_RST} aria2c multiproceso (si está disponible en el sistema)
  - ${C_CYAN}Transparencia:${C_RST} cualquier flag adicional de yt-dlp sobreescribe los valores por defecto.

${C_BOLD}Ejemplos:${C_RST}
  ${C_GREEN}yt-audio${C_RST} "https://youtu.be/HWsOivtPz-o"                ${C_DIM}# Descargar canción en Opus + carátula 1:1${C_RST}
  ${C_GREEN}yt-audio${C_RST} --audio-format flac "https://youtu.be/..."    ${C_DIM}# Guardar en FLAC sin pérdida${C_RST}
  ${C_GREEN}yt-audio${C_RST} -P ~/Music "https://youtu.be/..."             ${C_DIM}# Guardar en una carpeta específica${C_RST}
EOF
  exit 0
fi

# Verificación ligera de dependencias óptimas (solo avisa si falta alguna)
_missing=()
for _bin in ffmpeg aria2c deno; do
  command -v "$_bin" >/dev/null 2>&1 || _missing+=("$_bin")
done
python3 -c "import mutagen" 2>/dev/null || _missing+=("python-mutagen")
python3 -c "import curl_cffi" 2>/dev/null || _missing+=("python-curl_cffi")
if [[ ${#_missing[@]} -gt 0 ]]; then
  printf '%s[yt-audio] Aviso: faltan dependencias óptimas (%s). Ejecuta '\''chezmoi apply'\''.%s\n' \
    "$C_YELLOW" "${_missing[*]}" "$C_RST" >&2
fi

# Destino predeterminado (con fallback automático si /z-drive no está montado)
if [[ -d "/z-drive/idalia/MUSICA" ]]; then
  DEST_DIR="/z-drive/idalia/MUSICA/Downloads"
else
  DEST_DIR="${XDG_MUSIC_DIR:-$HOME/Music}/Downloads"
fi
mkdir -p "$DEST_DIR" 2>/dev/null || true

DEFAULT_ARGS=(
  --ignore-config
  --no-playlist
  --ignore-errors
  --continue
  --no-overwrites
  --restrict-filenames
  --sleep-requests 1
  -x
  -f "bestaudio/best"
  --audio-format opus
  --audio-quality 0
  --embed-thumbnail
  --convert-thumbnails jpg
  --embed-metadata
  --sponsorblock-remove sponsor,selfpromo,interaction
  -P "$DEST_DIR"
  -o "%(uploader)s/%(title)s.%(ext)s"
)

if command -v aria2c >/dev/null 2>&1; then
  DEFAULT_ARGS+=(
    --downloader aria2c
    --downloader-args aria2c:'--continue --min-split-size=5M --max-connection-per-server=4'
  )
fi

if command -v yt-dlp-music-postprocess >/dev/null 2>&1; then
  DEFAULT_ARGS+=(--exec "after_move:yt-dlp-music-postprocess %(filepath)q")
fi

exec yt-dlp "${DEFAULT_ARGS[@]}" "$@"
