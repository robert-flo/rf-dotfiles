#!/usr/bin/env bash
# ==============================================================================
# yt-audio-playlist — Descargador de playlists musicales y podcasts en Opus.
#
# Descarga playlists completas en Opus máxima calidad dentro de una subcarpeta
# ordenada (01 - Artista - Título.opus), con tags album/tracknumber, carátula
# 1:1 incrustada, pausas anti-429 e historial en ~/.local/state/yt-audio-playlist/.
# ==============================================================================
set -euo pipefail

# Colores ANSI estándar (0-15) compatibles con modo claro y modo oscuro
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_BOLD=$'\033[1m'
  C_BLUE=$'\033[34m'
  C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
  C_RST=$'\033[0m'
else
  C_BOLD=""; C_BLUE=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_DIM=""; C_RST=""
fi

if [[ $# -eq 0 ]]; then
  cat << EOF
${C_BOLD}${C_BLUE}yt-audio-playlist${C_RST} — Descarga playlists de música o podcasts en Opus (+ carátula y tags)

${C_BOLD}Uso:${C_RST}
  ${C_GREEN}yt-audio-playlist${C_RST} ${C_CYAN}[--list | -L] [--no-archive] [OPCIONES_YT_DLP]${C_RST} <URL_PLAYLIST> [URL...]

${C_BOLD}Opciones propias del wrapper:${C_RST}
  ${C_CYAN}--list, -L${C_RST}     Inspección rápida: lista índice, duración y título sin descargar
  ${C_CYAN}--no-archive${C_RST}   Omite el archivo de progreso (permite re-descargar pistas ya registradas)

${C_BOLD}Características predeterminadas:${C_RST}
  - ${C_CYAN}Playlist:${C_RST} descarga completa (--yes-playlist) saltando pistas no disponibles (--ignore-errors)
  - ${C_CYAN}Organización:${C_RST} /zt/yt-downloads/audio-playlist/<Playlist>/01 - Artista - Título.opus ${C_DIM}(fallback: ~/yt-downloads/audio-playlist/)${C_RST}
  - ${C_CYAN}Metadatos:${C_RST} etiqueta album=<Playlist>, tracknumber=<índice> y carátula 1:1 (METADATA_BLOCK_PICTURE)
  - ${C_CYAN}Progreso:${C_RST} ~/.local/state/yt-audio-playlist/<playlist_id>.archive (salta pistas ya bajadas)
  - ${C_CYAN}Formato:${C_RST} Opus máxima calidad + SponsorBlock (sponsor, selfpromo, interaction)
  - ${C_CYAN}Protección anti-429:${C_RST} pausas cortas entre peticiones y pistas
  - ${C_CYAN}Acelerador:${C_RST} aria2c multiproceso (si está disponible en el sistema)
  - ${C_CYAN}Transparencia:${C_RST} cualquier flag adicional de yt-dlp sobreescribe los valores por defecto.

${C_BOLD}Ejemplos:${C_RST}
  ${C_GREEN}yt-audio-playlist${C_RST} --list "https://www.youtube.com/playlist?list=..."              ${C_DIM}# Ver pistas antes de descargar${C_RST}
  ${C_GREEN}yt-audio-playlist${C_RST} "https://www.youtube.com/playlist?list=..."                     ${C_DIM}# Descargar álbum o podcast completo${C_RST}
  ${C_GREEN}yt-audio-playlist${C_RST} --playlist-items 1-10 "https://www.youtube.com/playlist?list=..." ${C_DIM}# Descargar solo pistas 1 a 10${C_RST}
  ${C_GREEN}yt-audio-playlist${C_RST} -P ~/Music/Podcasts "https://www.youtube.com/playlist?list=..."   ${C_DIM}# Guardar en otra carpeta${C_RST}
EOF
  exit 0
fi

# Parsear flags propios del wrapper sin interferir con los flags de yt-dlp
LIST_ONLY=false
USE_ARCHIVE=true
USER_SET_ARCHIVE=false
PASS_ARGS=()
PLAYLIST_ID=""

for arg in "$@"; do
  case "$arg" in
    --list|-L)
      LIST_ONLY=true
      ;;
    --no-archive)
      USE_ARCHIVE=false
      ;;
    --download-archive|--download-archive=*)
      USER_SET_ARCHIVE=true
      PASS_ARGS+=("$arg")
      ;;
    *)
      PASS_ARGS+=("$arg")
      if [[ -z "$PLAYLIST_ID" && "$arg" =~ [?\&]list=([A-Za-z0-9_-]+) ]]; then
        PLAYLIST_ID="${BASH_REMATCH[1]}"
      fi
      ;;
  esac
done

# Modo inspección rápida: muestra índice, duración y título sin descargar
if [[ "$LIST_ONLY" == true ]]; then
  exec yt-dlp \
    --ignore-config \
    --flat-playlist \
    --yes-playlist \
    --print "%(playlist_index)03d | %(duration_string)8s | %(title)s [%(id)s]" \
    "${PASS_ARGS[@]}"
fi

# Verificación ligera de dependencias óptimas (solo avisa si falta alguna)
_missing=()
for _bin in ffmpeg aria2c deno; do
  command -v "$_bin" >/dev/null 2>&1 || _missing+=("$_bin")
done
python3 -c "import mutagen" 2>/dev/null || _missing+=("python-mutagen")
python3 -c "import curl_cffi" 2>/dev/null || _missing+=("python-curl_cffi")
if [[ ${#_missing[@]} -gt 0 ]]; then
  printf '%s[yt-audio-playlist] Aviso: faltan dependencias óptimas (%s). Ejecuta '\''chezmoi apply'\''.%s\n' \
    "$C_YELLOW" "${_missing[*]}" "$C_RST" >&2
fi

# Directorio base unificado (/zt/yt-downloads si /zt existe, si no ~/yt-downloads)
if [[ -d "/zt" ]]; then
  BASE_DIR="/zt/yt-downloads"
else
  BASE_DIR="$HOME/yt-downloads"
fi
DEST_DIR="$BASE_DIR/audio-playlist"
mkdir -p "$DEST_DIR" 2>/dev/null || true

DEFAULT_ARGS=(
  --ignore-config
  --yes-playlist
  --ignore-errors
  --continue
  --no-overwrites
  --restrict-filenames
  --sleep-requests 1
  --sleep-interval 2
  --max-sleep-interval 5
  -x
  -f "bestaudio/best"
  --audio-format opus
  --audio-quality 0
  --embed-thumbnail
  --convert-thumbnails jpg
  --embed-metadata
  --sponsorblock-remove "sponsor,selfpromo,interaction"
  -P "$DEST_DIR"
  -o "%(playlist_title,playlist_id)s/%(title)s.%(ext)s"
)

# Archivo de progreso por playlist fuera de la carpeta de audio
if [[ "$USE_ARCHIVE" == true && "$USER_SET_ARCHIVE" == false ]]; then
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yt-audio-playlist"
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  ARCHIVE_NAME="${PLAYLIST_ID:-default}.archive"
  DEFAULT_ARGS+=(--download-archive "$STATE_DIR/$ARCHIVE_NAME")
fi

if command -v aria2c >/dev/null 2>&1; then
  DEFAULT_ARGS+=(
    --downloader aria2c
    --downloader-args aria2c:'--continue --min-split-size=5M --max-connection-per-server=4'
  )
fi

if command -v yt-dlp-music-postprocess >/dev/null 2>&1; then
  DEFAULT_ARGS+=(
    --exec "after_move:yt-dlp-music-postprocess --album %(playlist_title,playlist_id)q --track %(playlist_index)q %(filepath)q"
  )
fi

exec yt-dlp "${DEFAULT_ARGS[@]}" "${PASS_ARGS[@]}"
