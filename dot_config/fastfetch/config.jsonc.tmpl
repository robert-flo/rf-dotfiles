{{- if eq .chezmoi.username "niri-upstream" -}}
{{ include ".upstream/fastfetch/config.jsonc" }}
{{- else -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "{{ .chezmoi.homeDir }}/.config/fastfetch/logo/ryuzaki.icon",
    "height": 13,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " │ "
  },
  "modules": [
    {
      "type": "command",
      "key": "  Year    ",
      "keyColor": "blue",
      "text": "y=$(date +%Y); d=$(date +%j); d=${d#0}; d=${d#0}; t=365; [ $(( (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 )) -eq 1 ] && t=366; printf 'El %d%% del año ya se fue 😥\\n' $(( d * 100 / t ))"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐"
    },
    {
      "type": "chassis",
      "key": " 󰇺 Chassis ",
      "format": "{1} {2} {3}"
    },
    {
      "type": "os",
      "key": " 󰣇 OS      ",
      "format": "RobertOS-RaVN",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "  Kernel  ",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": " 󰏗 Packages",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": " 󰍹 Display ",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": " 󱗃 WM      ",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": "  User    ",
      "format": "{6} {7} {8}"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "  CPU     ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": " 󰊴 GPU     ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": "  Driver  ",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "  Memory  ",
      "keyColor": "magenta",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": " 󰋊 Storage ",
      "folders": "/",
      "keyColor": "cyan",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "command",
      "key": " 󱦟 OS Age  ",
      "keyColor": "red",
      "text": "echo $(( ($(date +%s) - $(stat -c %Y /lost+found 2>/dev/null || stat -c %Y /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": " 󱫐 Uptime  ",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐"
    },
    {
      "type": "command",
      "key": " 󰎆 Spotify ",
      "keyColor": "green",
      "text": "playerctl --player=spotify metadata --format '{{ "{{title}} - {{artist}}" }}' 2>/dev/null || echo 'Not playing'"
    },
    {
      "type": "weather",
      "key": " 󰖕 Weather ",
      "location": "Ilopango,El_Salvador",
      "outputFormat": "%t+-+%C",
      "keyColor": "yellow",
      "timeout": 5000
    },
    {
      "type": "custom",
      "key": " 󰍎 Location",
      "keyColor": "yellow",
      "format": "Ilopango, El Salvador"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
{{ end -}}
