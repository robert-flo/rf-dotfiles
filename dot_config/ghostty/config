# Theme & Appearance
theme = "Solarized Dark - Patched"
background-opacity = 0.8
background-blur-radius = 20

# Polaridad fija Dark (contrato RF_TERM_THEME)
env = RF_TERM_THEME=dark
env = COLORFGBG=15;0
env = BAT_THEME=ansi
env = GLAMOUR_STYLE=dark

# Font
font-family = "Maple Mono NF"
# font-family = "CaskaydiaCove Nerd Font Mono"
# font-family = "BlexMono Nerd Font"
# font-family = "PlemolJP Console NF"
# font-family = "JetBrainsMono Nerd Font"
# font-family = "FiraCode Nerd Font"
# font-size = 11
# Neovide: hinting = "full", edging = "antialias". Ghostty no tiene esas claves.

# Cursor
cursor-style = block
cursor-style-blink = true
adjust-cursor-height = 40%
adjust-cursor-thickness = 100%
adjust-box-thickness = 100%
adjust-underline-thickness = 100%
adjust-underline-position = 110%

# Window & Behavior
window-padding-x = 8
window-padding-y = 8
window-decoration = none
window-inherit-working-directory = true
resize-overlay = never
desktop-notifications = true
confirm-close-surface = false
gtk-single-instance = true
bell-features = no-system
macos-option-as-alt = left

# Shell Integration
shell-integration-features = ssh-env,ssh-terminfo

# Vlog Mode (optional)
# config-file = config_vlog

# Keybindings
# keybind = global:cmd+ctrl+shift+j=toggle_visibility
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = ctrl+shift+i=inspector:toggle
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+0=reset_font_size
keybind = ctrl+shift+r=reload_config
keybind = ctrl++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1

# --- Adaptado para ceder splits/tabs a herdr ---
keybind = ctrl+shift+j=unbind
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind

# Splits/tabs propios de Ghostty (comentados en favor de herdr; descomentar si se usan sin herdr)
# keybind = alt+v=new_split:right
# keybind = alt+s=new_split:down
# keybind = alt+h=goto_split:left
# keybind = alt+l=goto_split:right
# keybind = alt+j=goto_split:bottom
# keybind = alt+k=goto_split:top
# keybind = alt+n=new_tab
# keybind = shift+alt+h=goto_split:left
# keybind = shift+alt+l=goto_split:right
# keybind = shift+alt+j=goto_split:bottom
# keybind = shift+alt+k=goto_split:top
window-padding-color = extend
