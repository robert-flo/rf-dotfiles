// Managed by Clavis.
binds {
    Mod+Space repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "spotlight" "toggle";
    };
    Mod+Shift+Space repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "spotlight" "openMode" "apps";
    };
    Mod+Ctrl+Space repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "spotlight" "commands";
    };
    Mod+Alt+V repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "spotlight" "openMode" "clipboard";
    };
    Mod+Alt+W repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "spotlight" "openMode" "wallpapers";
    };
    Mod+Slash repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "shortcut-map" "toggle";
    };
    Mod+BackSpace repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "power-menu" "toggle";
    };
    Mod+N repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "sidebar" "toggle" "dashboard";
    };
    Mod+A repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "sidebar" "toggle" "quicksettings";
    };
    Mod+Shift+W repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "keystone" "hub";
    };
    Alt+Shift+L repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "lock" "open";
    };

    Super+F2 repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "keystone" "dashboard";
    };

    Super+F3 repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "keystone" "lyrics";
    };

    Super+F4 repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "keystone" "tools";
    };

    Super+F5 repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "sidebar" "toggle" "weather";
    };

    Super+F6 repeat=false {
        spawn "qs" "-c" "clavis" "ipc" "call" "control-center" "toggle" "account";
    };

    Super+F7 repeat=false {
        spawn-sh "cava-glsl -m";
    };

    Super+F8 repeat=false {
        spawn "omarchy-capture-text";
    };

    Super+F9 repeat=false {
        spawn-sh "clavis-emoji-picker.sh";
    };

    Super+F10 repeat=false {
        spawn-sh "clavis-cycle-animations.sh";
    };

    Super+F11 repeat=false {
        spawn-sh "clavis-toggle-bars.sh";
    };

    Super+F12 repeat=false {
        spawn-sh "clavis-toggle-maximize-all.sh";
    };
};
