layout {
    focus-ring {
        width 4
        active-color "#4b5c92"
        active-gradient from="#4b5c92" to="#745470" angle=135
        inactive-color "transparent"
        urgent-color "#ba1a1a"
    }
    shadow {
        on
        softness 38
        spread 10
        offset x=0 y=0
        draw-behind-window false
        color "#58a6ffb8"
        inactive-color "#00000045"
    }
}
recent-windows {    
    highlight {
        active-color "#faf8ff"
        urgent-color "#ba1a1a"
    }
}
