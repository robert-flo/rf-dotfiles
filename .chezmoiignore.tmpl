# Global ignores (never put in user's home)
README.md
AGENTS.md
.git*
.chezmoidata/**
.upstream/**
.personal/**
.config/fish/nyxuri-config.fish

# Auto-detect profile based on username or CHEZMOI_PROFILE
{{- $profile := env "CHEZMOI_PROFILE" -}}
{{- if not $profile -}}
{{-   if eq .chezmoi.username "niri-upstream" -}}
{{-     $profile = "clavis-upstream" -}}
{{-   else if or (eq .chezmoi.username "niri") (eq .chezmoi.username "niri-classic") (eq .chezmoi.username "niri-test") (eq .chezmoi.username "sura") -}}
{{-     $profile = "clavis" -}}
{{-   else if or (eq .chezmoi.username "nyxuri") (eq .chezmoi.username "nyxuri-test") (eq .chezmoi.username "nyxuri-legacy") -}}
{{-     $profile = "nyxuri" -}}
{{-   else -}}
{{-     $profile = "omarchy" -}}
{{-   end -}}
{{- end -}}

# Exclude personal Clavis / Niri when not in clavis or clavis-upstream profile
{{ if and (ne $profile "clavis") (ne $profile "clavis-upstream") }}
.config/niri/**
.config/clavis/**
.config/gtk-3.0/**
.config/gtk-4.0/**
.config/fcitx5/**
.config/environment.d/**
.config/waybar/**
.config/mako/**
.config/fuzzel/**
.icons/**
.local/bin/clavis-mpvpaper.sh
.local/bin/niri-dotfiles-postinstall
.local/bin/optimize-wallpaper
.local/share/**
clavis-postinstall.sh
.config/systemd/**
{{ end }}

# When in clavis-upstream (pure upstream), exclude personal workstation customization
{{ if eq $profile "clavis-upstream" }}
Documents/**
dot_Work/**
symlink_Cloud
symlink__boveda
symlink_Idalia
symlink_Uploads-Gracie
symlink_Vaughan
.config/obsidian/**
.config/thunderbird/**
.config/rclone/**
.zen/**
.zshrc
clavis-postinstall.sh
.local/bin/**
.config/niri/clavis/**
.config/niri/liquidbird.kdl
.config/niri/obsidian-violet.kdl
.config/niri/statindet-*.kdl
.config/gtk-3.0/**
.config/gtk-4.0/**
.config/waybar/**
.config/mako/**
.config/fuzzel/**
.config/fish/**
.config/alacritty/**
.config/tmux/**
