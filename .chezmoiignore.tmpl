# Global ignores (never put in user's home)
README.md
AGENTS.md
.git*
.chezmoidata/**

# Auto-detect profile based on username or CHEZMOI_PROFILE
{{- $profile := env "CHEZMOI_PROFILE" -}}
{{- if not $profile -}}
{{-   if or (eq .chezmoi.username "niri") (eq .chezmoi.username "niri-test") (eq .chezmoi.username "sura") -}}
{{-     $profile = "clavis" -}}
{{-   else if or (eq .chezmoi.username "nyxuri") (eq .chezmoi.username "nyxuri-test") (eq .chezmoi.username "nyxuri-legacy") -}}
{{-     $profile = "nyxuri" -}}
{{-   else -}}
{{-     $profile = "omarchy" -}}
{{-   end -}}
{{- end -}}

# Exclude Clavis / Niri specific dotfiles when not in clavis profile
{{ if ne $profile "clavis" }}
.config/niri/**
.config/clavis/**
.config/gtk-3.0/**
.config/gtk-4.0/**
.config/fcitx5/**
.config/mpv/**
.config/obsidian/**
.config/environment.d/**
.config/waybar/**
.config/mako/**
.config/fuzzel/**
.config/thunderbird/**
.icons/**
.local/bin/**
.local/share/**
Documents/**
clavis-postinstall.sh
.config/systemd/**
{{ end }}

# Exclude Omarchy / Hyprland when not in omarchy profile
{{ if ne $profile "omarchy" }}
.config/hypr/**
.config/omarchy/**
.local/state/omarchy/**
{{ end }}
