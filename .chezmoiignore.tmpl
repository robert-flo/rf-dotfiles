# Global ignores (never put in user's home)
Makefile
make/**
README.md
AGENTS.md
docs/**
scripts/**
.git*
.chezmoidata/**
.upstream/**
.personal/**
.config/fish/nyxuri-config.fish
.config/ghostty/auto/**
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/.plugins.lock
.config/herdr/plugins.json
.config/herdr/session*
.config/herdr/plugins/github-installations/**
.config/herdr/plugins/.locks/**

# Ignore video wallpapers symlink if shared collection is not present
{{ if not (stat "/z/wallpaper-collection/video") }}
.local/share/clavis/wallpapers/video
{{ end }}

# Auto-detect profile based on username or CHEZMOI_PROFILE
{{- $profile := env "CHEZMOI_PROFILE" -}}
{{- if not $profile -}}
{{-   if eq .chezmoi.username "niri-upstream" -}}
{{-     $profile = "clavis-upstream" -}}
{{-   else if or (eq .chezmoi.username "niri") (eq .chezmoi.username "niri-classic") (eq .chezmoi.username "niri-test") (eq .chezmoi.username "sura") -}}
{{-     $profile = "clavis" -}}
{{-   else if or (eq .chezmoi.username "nyxuri") (eq .chezmoi.username "nyxuri-test") (eq .chezmoi.username "nyxuri-legacy") -}}
{{-     $profile = "nyxuri" -}}
{{-   else -}}
{{-     $profile = "omarchy" -}}
{{-   end -}}
{{- end -}}

